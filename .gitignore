node_modules
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz

# Données PostgreSQL locales — ne doivent jamais être versionnées (contiennent des données réelles,
# y compris des hash de mots de passe)
.pgdata/

# Secrets locaux — .env.example et .env.test restent trackés (aucune valeur réelle dedans)
.env
.env.local
.env.production

# Config/état locaux d'outillage — spécifiques à la machine de dev, pas au projet
.claude/
.local/

# Environnement Docker local (secrets generes) — .env.docker.example reste tracke
.env.docker
.env.docker.*
!.env.docker.example

# Sauvegarde brute du cluster PostgreSQL : contient des donnees reelles et des
# hash de mots de passe. Ne doit jamais etre versionnee (meme motif que .pgdata/).
_pgdata_backup/

# Montages liés de docker-compose (data/postgres, data/uploads, data/logs…).
# Contient des données réelles et des hash de mots de passe : même motif que
# .pgdata/ et _pgdata_backup/.
#
# ⚠️ ANCRÉ à la racine, et il doit le rester. Écrite `data/`, sans barre
# oblique initiale, cette règle vise TOUT dossier nommé `data` à n'importe
# quelle profondeur — à commencer par `client/src/data/`, qui contient du code
# source. `git add` d'un nouveau fichier y était refusé en silence, donc
# absent du dépôt, donc absent du déploiement, sans que rien ne le signale.
# `trainingContent.ts` n'y a survécu que parce qu'il était suivi avant.
/data/

# Rapport Jest produit par `npm test` — utile pour relire les échecs, pas à versionner.
test-report.json

# Environnement de test cloud (secrets generes, jamais versionnes)
.env.test-cloud
ssl/*.crt
ssl/*.key

# Rapport Playwright
e2e-report.json
playwright-report/
test-results/

# Jetons ephemeres du defi Let's Encrypt
certbot-webroot/.well-known/

# Documents de travail (audits, rapports)
Audit_Technique_Maintrix.docx
captures/
# ...sauf les captures avant/après de l'audit UX/UI : ce sont un livrable,
# et docs/audit-ux/CAPTURES.md y renvoie. Sans cette exception, les liens du
# rapport pointent vers des fichiers absents du dépôt (constaté le 20/10/2026 :
# aucune des captures des étapes B et D n'était suivie).
!docs/audit-ux/captures/
!docs/audit-ux/captures/*.jpg

# 🔐 Configuration Environnement - Maintrix v2.6.0
# Copiez ce fichier vers .env et personnalisez les valeurs
# ══════════════════════════════════════════════════════════

# =================================
# BASE DE DONNÉES POSTGRESQL
# =================================
DATABASE_URL="postgresql://maintrix_user:votre_mot_de_passe_securise@localhost:5432/maintrix_db"
PGHOST=localhost
PGPORT=5432
PGUSER=maintrix_user
PGPASSWORD=votre_mot_de_passe_securise
PGDATABASE=maintrix_db

# =================================
# APPLICATION
# =================================
NODE_ENV=production
PORT=5000
APP_URL=https://votre-domaine.com

# =================================
# SÉCURITÉ (OBLIGATOIRE EN PRODUCTION)
# =================================
SESSION_SECRET=CHANGEME_minimum_32_caracteres_aleatoires
JWT_SECRET=CHANGEME_minimum_32_caracteres_aleatoires
MFA_ENCRYPTION_KEY=CHANGEME_minimum_32_caracteres_aleatoires
KMS_MASTER_KEY=CHANGEME_minimum_32_caracteres_aleatoires

# Accès super-admin — laisser vide bloque l'accès super-admin en production (comportement voulu
# tant que ces valeurs ne sont pas définies explicitement). Générer le hash avec :
#   node -e "console.log(require('bcrypt').hashSync('votre_mot_de_passe', 12))"
SUPER_ADMIN_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=

# =================================
# INTELLIGENCE ARTIFICIELLE
# =================================
# Clé Anthropic Claude pour diagnostics IA avancés
# Obtenir sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXX

# =================================
# PAIEMENTS — STRIPE
# =================================
# Obtenir sur https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXX
STRIPE_SECRET_KEY=sk_live_XXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXX

# =================================
# PAIEMENTS — PAYPAL
# =================================
# Obtenir sur https://developer.paypal.com/
PAYPAL_CLIENT_ID=XXXXXXXX
PAYPAL_CLIENT_SECRET=XXXXXXXX
PAYPAL_MODE=live
# PAYPAL_MODE=sandbox   # pour les tests

# =================================
# EMAIL — SENDGRID
# =================================
# Obtenir sur https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.XXXXXXXX
SENDGRID_FROM_EMAIL=noreply@votre-domaine.com
SENDGRID_FROM_NAME=Maintrix

# =================================
# REDIS CACHE (sessions + cache)
# =================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# =================================
# CORS ET SÉCURITÉ
# =================================
ALLOWED_ORIGINS="https://votre-domaine.com,https://app.votre-domaine.com"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# MONITORING ET LOGS
# =================================
LOG_LEVEL=info
LOG_FORMAT=combined

# =================================
# LICENCE MAINTRIX
# =================================
# Clé de licence fournie après achat
MAINTRIX_LICENSE_KEY=
LICENSE_SERVER_URL=https://license.maintrix.io

# =================================
# IoT — MQTT (OPTIONNEL)
# =================================
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# =================================
# INTÉGRATIONS ERP (OPTIONNEL)
# =================================
# SAP ERP
SAP_BASE_URL=
SAP_USERNAME=
SAP_PASSWORD=

# IBM Maximo
MAXIMO_BASE_URL=
MAXIMO_USERNAME=
MAXIMO_PASSWORD=

# SCADA
SCADA_ENDPOINT=

# =================================
# CONFIGURATION MÉTIER
# =================================
MAX_EQUIPMENT_PER_ORG=1000
MAINTENANCE_LOG_RETENTION_DAYS=365
IOT_MONITORING_INTERVAL=30

# =================================
# ELECTRON DESKTOP (interne)
# =================================
ELECTRON_RUN=0

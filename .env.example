# 🔐 Configuration Environnement - Maintrix
# Copiez ce fichier vers .env et personnalisez les valeurs

# =================================
# BASE DE DONNÉES POSTGRESQL
# =================================
DATABASE_URL="postgresql://maintrix_user:votre_mot_de_passe_securise@localhost:5432/maintrix_db"
PGHOST=localhost
PGPORT=5432
PGUSER=maintrix_user
PGPASSWORD=votre_mot_de_passe_securise
PGDATABASE=maintrix_db

# =================================
# APPLICATION
# =================================
NODE_ENV=production
PORT=5000
SESSION_SECRET=votre_cle_session_securisee_minimum_32_caracteres_aleatoires

# =================================
# INTELLIGENCE ARTIFICIELLE (OPTIONNEL)
# =================================
# Clé Anthropic Claude pour diagnostics IA avancés
ANTHROPIC_API_KEY=votre_cle_anthropic_optionnelle

# =================================
# PAIEMENTS (OPTIONNEL)
# =================================
# Stripe - Obtenez vos clés sur https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_votre_cle_publique
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete

# PayPal - Obtenez vos clés sur https://developer.paypal.com/
PAYPAL_CLIENT_ID=votre_client_id_paypal
PAYPAL_CLIENT_SECRET=votre_secret_paypal
PAYPAL_MODE=sandbox

# =================================
# EMAIL - SENDGRID (OPTIONNEL)
# =================================
# Clé SendGrid pour notifications et invitations
SENDGRID_API_KEY=votre_cle_sendgrid

# =================================
# SÉCURITÉ
# =================================
# Domaines autorisés (pour production)
ALLOWED_ORIGINS="http://localhost:5000,https://votre-domaine.com"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# MONITORING ET LOGS
# =================================
LOG_LEVEL=info
LOG_FORMAT=combined

# =================================
# REDIS CACHE (OPTIONNEL)
# =================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# =================================
# CONFIGURATION MÉTIER
# =================================
# Nombre maximum d'équipements par organisation
MAX_EQUIPMENT_PER_ORG=1000

# Rétention des logs de maintenance (jours)
MAINTENANCE_LOG_RETENTION_DAYS=365

# Intervalle de monitoring IoT (secondes)
IOT_MONITORING_INTERVAL=30

# ═══════════════════════════════════════════════════════════════════
# Modèle d'environnement Docker — Maintrix
# ═══════════════════════════════════════════════════════════════════
# CE FICHIER EST VERSIONNÉ : il ne doit contenir AUCUNE valeur réelle.
#
# Usage :
#   1. bash scripts/generate-docker-env.sh        → génère .env.docker (ignoré par git)
#   2. docker compose --env-file .env.docker up -d
#
# Les variables marquées OBLIGATOIRE n'ont pas de valeur par défaut :
# `docker compose` échoue immédiatement si elles sont absentes (syntaxe ${VAR:?...}).
# C'est volontaire — aucun secret de repli ne doit exister.
#
# ⚠ Interpolation : docker compose interprète `$` dans ce fichier.
#   Une valeur contenant un `$` littéral (ex. hash bcrypt `$2b$10$...`)
#   doit être écrite avec `$$` : `$$2b$$10$$...`
# ═══════════════════════════════════════════════════════════════════

# ---- Base de données (OBLIGATOIRE) ----
# Mot de passe unique : utilisé par les services `db`, `app` et `backup`.
POSTGRES_PASSWORD=
# Optionnels (valeurs par défaut : maintrix_db / maintrix_user)
POSTGRES_DB=
POSTGRES_USER=

# ---- Secrets applicatifs (OBLIGATOIRES) ----
# server/index.ts bloque le démarrage en production si l'un d'eux manque.
# Générer avec : openssl rand -hex 64  (32 pour les clés de chiffrement)
SESSION_SECRET=
JWT_SECRET=
KMS_MASTER_KEY=
MFA_ENCRYPTION_KEY=

# ---- Infrastructure (OBLIGATOIRES) ----
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# ---- Services externes (optionnels — dégradation fonctionnelle si absents) ----
ANTHROPIC_API_KEY=
SENDGRID_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

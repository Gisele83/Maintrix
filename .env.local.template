# =================================
# MAINTRIX - Configuration Locale
# Template de configuration pour installation client
# =================================

# Version du progiciel
MAINTRIX_VERSION=2.0.0

# =================================
# CONFIGURATION BASE DE DONNÉES
# =================================
DB_PASSWORD=maintrix_secure_password_change_me
DB_PORT=5433
PGHOST=maintrix-db
PGPORT=5432
PGUSER=maintrix_admin
PGDATABASE=maintrix_local

# URL complète de connexion (générée automatiquement)
DATABASE_URL=postgresql://maintrix_admin:${DB_PASSWORD}@maintrix-db:5432/maintrix_local

# =================================
# CONFIGURATION SERVEUR
# =================================
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
WEB_PORT=8080
PROXY_PORT=80

# =================================
# SÉCURITÉ
# =================================
SESSION_SECRET=maintrix_session_key_change_in_production
LOCAL_DEPLOYMENT=true
DISABLE_TELEMETRY=true
DISABLE_ANALYTICS=true

# Domaines autorisés (modifiez selon votre configuration)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://0.0.0.0:8080

# =================================
# DOMAINE ET SSL (OPTIONNEL)
# =================================
# DOMAIN_NAME=maintrix.votre-entreprise.com
# SSL_ENABLED=false
# SSL_CERT_PATH=/etc/ssl/certs/maintrix.crt
# SSL_KEY_PATH=/etc/ssl/private/maintrix.key

# =================================
# APIS EXTERNES (OPTIONNELLES)
# =================================

# Intelligence Artificielle Claude (Anthropic)
# Obtenir une clé API sur: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# Service Email SendGrid
# Obtenir une clé API sur: https://sendgrid.com/
# SENDGRID_API_KEY=SG.xxxxx
# SENDGRID_FROM_EMAIL=noreply@votre-entreprise.com

# Paiements Stripe (pour version commerciale)
# STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxx

# PayPal (alternative paiement)
# PAYPAL_CLIENT_ID=xxxxx
# PAYPAL_CLIENT_SECRET=xxxxx
# PAYPAL_MODE=sandbox

# =================================
# SAUVEGARDE ET MAINTENANCE
# =================================
# Planification des sauvegardes (format cron)
BACKUP_SCHEDULE=0 2 * * *  # Tous les jours à 2h du matin
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESS=true

# Rotation des logs
LOG_LEVEL=info
LOG_RETENTION_DAYS=7
LOG_MAX_SIZE=100MB

# =================================
# FONCTIONNALITÉS AVANCÉES
# =================================

# Monitoring et métriques
ENABLE_MONITORING=false
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Cache Redis (optionnel)
ENABLE_REDIS=false
REDIS_URL=redis://redis:6379

# Mode développement (désactivé en production)
DEBUG_MODE=false
VERBOSE_LOGGING=false

# =================================
# INTÉGRATIONS ERP (OPTIONNELLES)
# =================================

# SAP ERP
# SAP_HOST=
# SAP_USER=
# SAP_PASSWORD=
# SAP_CLIENT=

# Microsoft Dynamics
# DYNAMICS_URL=
# DYNAMICS_CLIENT_ID=
# DYNAMICS_CLIENT_SECRET=

# Oracle ERP
# ORACLE_HOST=
# ORACLE_PORT=
# ORACLE_SID=
# ORACLE_USER=
# ORACLE_PASSWORD=

# =================================
# NOTIFICATIONS
# =================================

# Slack (notifications système)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx
# SLACK_CHANNEL=#maintrix-alerts

# Microsoft Teams
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxxxx

# SMS (Twilio)
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_PHONE_NUMBER=+33xxxxxxxxx

# =================================
# STOCKAGE EXTERNE (OPTIONNEL)
# =================================

# Amazon S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_REGION=eu-west-1

# Google Cloud Storage
# GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_CLOUD_KEYFILE=
# GOOGLE_CLOUD_BUCKET=

# Azure Blob Storage
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=

# =================================
# CONFIGURATION RÉSEAU
# =================================

# Proxy sortant (si votre entreprise utilise un proxy)
# HTTP_PROXY=http://proxy.entreprise.com:8080
# HTTPS_PROXY=http://proxy.entreprise.com:8080
# NO_PROXY=localhost,127.0.0.1

# Limite de taille des fichiers uploadés
MAX_FILE_SIZE=100MB
UPLOAD_TIMEOUT=300s

# =================================
# PERSONNALISATION ENTREPRISE
# =================================

# Nom de l'entreprise (affiché dans l'interface)
COMPANY_NAME=Votre Entreprise
COMPANY_LOGO_URL=/uploads/logo-entreprise.png

# Thème de l'interface
THEME_PRIMARY_COLOR=#1f2937
THEME_SECONDARY_COLOR=#3b82f6
THEME_ACCENT_COLOR=#10b981

# Langue par défaut
DEFAULT_LANGUAGE=fr
AVAILABLE_LANGUAGES=fr,en

# =================================
# LIMITES ET QUOTAS
# =================================

# Limites utilisateurs
MAX_USERS=100
MAX_EQUIPMENT=1000
MAX_WORK_ORDERS_PER_MONTH=5000

# Limites de l'API
API_RATE_LIMIT=1000  # Requêtes par heure par IP
API_BURST_LIMIT=50   # Requêtes simultanées

# =================================
# DÉVELOPPEMENT ET DÉBOGAGE
# =================================
# Ces options ne doivent PAS être activées en production

# Mode debug (NE PAS ACTIVER EN PRODUCTION)
# DEBUG=false
# NODE_DEBUG=false

# Profiling des performances
# ENABLE_PROFILING=false

# Tests automatisés
# ENABLE_TESTING=false
# TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5434/maintrix_test
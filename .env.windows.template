# 🚀 MAINTRIX - Configuration Windows
# Template de configuration pour installation Windows avec WSL2/Docker Desktop
# Copiez ce fichier vers .env.local et adaptez selon vos besoins

# =================================
# INFORMATIONS SYSTÈME
# =================================
MAINTRIX_VERSION=2.0.0
PLATFORM=windows
WINDOWS_DEPLOYMENT=true
LOCAL_DEPLOYMENT=true

# =================================
# CONFIGURATION RÉSEAU
# =================================
# Port web principal (interface utilisateur)
WEB_PORT=8080

# Port base de données PostgreSQL
DB_PORT=5433

# Ports proxy HTTP/HTTPS (optionnels)
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Port Redis cache (optionnel)
REDIS_PORT=6379

# Port monitoring (optionnel)
MONITOR_PORT=9100

# =================================
# BASE DE DONNÉES
# =================================
# Mot de passe PostgreSQL (CHANGEZ CETTE VALEUR!)
DB_PASSWORD=maintrix_secure_windows_2024_CHANGE_ME

# URL complète de connexion (générée automatiquement)
# DATABASE_URL=postgresql://maintrix_admin:${DB_PASSWORD}@localhost:${DB_PORT}/maintrix_local

# =================================
# SÉCURITÉ
# =================================
# Clé secrète pour les sessions (CHANGEZ CETTE VALEUR!)
SESSION_SECRET=maintrix_session_key_windows_secure_2024_CHANGE_ME

# Origines autorisées pour CORS
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://0.0.0.0:8080

# =================================
# RÉPERTOIRES WINDOWS
# =================================
# Répertoire d'installation principal
INSTALL_DIR=C:/Maintrix

# Répertoires de données
DATA_DIR=${INSTALL_DIR}/data
UPLOAD_DIR=${DATA_DIR}/uploads
LOGS_DIR=${DATA_DIR}/logs
BACKUP_DIR=${INSTALL_DIR}/backups
CONFIG_DIR=${INSTALL_DIR}/config

# =================================
# APIS EXTERNES (OPTIONNELLES)
# =================================
# API Anthropic Claude pour IA avancée
# Obtenez votre clé sur: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# API SendGrid pour emails
# Obtenez votre clé sur: https://sendgrid.com/
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@votre-entreprise.com

# API Stripe pour paiements (si nécessaire)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# API PayPal pour paiements alternatifs (si nécessaire)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# =================================
# CONFIGURATION DOMAINE
# =================================
# Nom de domaine (pour production)
DOMAIN_NAME=localhost

# Support SSL/HTTPS
SSL_ENABLED=false
SSL_CERT_PATH=${INSTALL_DIR}/ssl/cert.pem
SSL_KEY_PATH=${INSTALL_DIR}/ssl/key.pem

# =================================
# SAUVEGARDE
# =================================
# Planning des sauvegardes automatiques (format cron)
BACKUP_SCHEDULE=0 2 * * *  # Tous les jours à 2h du matin

# Rétention des sauvegardes (en jours)
BACKUP_RETENTION_DAYS=30

# Compression des sauvegardes
BACKUP_COMPRESSION=true

# =================================
# PERFORMANCE WINDOWS
# =================================
# Optimisations Node.js pour Windows
NODE_OPTIONS=--max-old-space-size=2048
UV_THREADPOOL_SIZE=8

# Limite mémoire Docker (recommandé pour Windows)
DOCKER_MEMORY_LIMIT=2g
DOCKER_CPU_LIMIT=2.0

# =================================
# ACTIVE DIRECTORY / LDAP (OPTIONNEL)
# =================================
# Intégration Active Directory Windows
LDAP_ENABLED=false
LDAP_URL=ldap://dc.votre-entreprise.local:389
LDAP_BIND_DN=CN=maintrix-service,OU=Services,DC=votre-entreprise,DC=local
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=OU=Users,DC=votre-entreprise,DC=local
LDAP_SEARCH_FILTER=(sAMAccountName={username})

# =================================
# INTÉGRATIONS ERP WINDOWS
# =================================
# SAP ERP (si applicable)
SAP_HOST=
SAP_USER=
SAP_PASSWORD=
SAP_CLIENT=
SAP_LANGUAGE=FR

# Microsoft Dynamics 365
DYNAMICS_URL=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_TENANT_ID=

# =================================
# MONITORING ET ALERTES
# =================================
# Activation du monitoring
ENABLE_MONITORING=false

# Notifications Slack pour alertes
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#maintrix-alerts

# Notifications Teams pour alertes
TEAMS_WEBHOOK_URL=

# Email pour alertes critiques
ALERT_EMAIL=admin@votre-entreprise.com

# =================================
# DÉVELOPPEMENT / DEBUG
# =================================
# Mode debug (uniquement en développement)
DEBUG=false
VERBOSE_LOGGING=false

# Désactivation télémétrie
DISABLE_TELEMETRY=true
DISABLE_ANALYTICS=true

# Mode maintenance
MAINTENANCE_MODE=false

# =================================
# CACHE ET SESSIONS
# =================================
# Configuration Redis (si activé)
REDIS_HOST=maintrix-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Configuration des sessions
SESSION_TIMEOUT=3600  # 1 heure
SESSION_STORE=memory  # ou 'redis' si Redis activé

# =================================
# LIMITES ET QUOTAS
# =================================
# Taille maximale des fichiers uploadés
MAX_FILE_SIZE=100MB

# Nombre maximum de connexions simultanées
MAX_CONNECTIONS=100

# Limite API requests par minute
API_RATE_LIMIT=1000

# =================================
# LOGS ET AUDIT
# =================================
# Niveau de logs
LOG_LEVEL=info  # debug, info, warn, error

# Rotation des logs
LOG_ROTATION=daily
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=30

# Audit trail
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=365

# =================================
# NOTIFICATIONS WINDOWS
# =================================
# Notifications Windows natives
WINDOWS_NOTIFICATIONS=true

# Notifications par email
EMAIL_NOTIFICATIONS=true

# Fréquence des notifications
NOTIFICATION_FREQUENCY=immediate  # immediate, hourly, daily

# =================================
# SCRIPTS ET AUTOMATISATION
# =================================
# Chemin vers les scripts PowerShell
SCRIPTS_PATH=${INSTALL_DIR}/scripts/windows

# Exécution automatique des mises à jour
AUTO_UPDATE=false

# Sauvegarde avant mise à jour
BACKUP_BEFORE_UPDATE=true

# =================================
# EXAMPLES DE CONFIGURATION TYPES
# =================================

# CONFIGURATION DÉVELOPPEMENT:
# WEB_PORT=8080
# DB_PASSWORD=dev_password_123
# DEBUG=true
# DISABLE_TELEMETRY=true

# CONFIGURATION TEST:
# WEB_PORT=8081
# DB_PASSWORD=test_password_456
# BACKUP_SCHEDULE=0 */6 * * *
# LOG_LEVEL=debug

# CONFIGURATION PRODUCTION:
# WEB_PORT=80
# SSL_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# ENABLE_MONITORING=true
# LOG_LEVEL=warn
# AUTO_UPDATE=false

# =================================
# NOTES IMPORTANTES
# =================================
# 1. Changez TOUS les mots de passe par défaut
# 2. Configurez SSL/HTTPS pour la production
# 3. Sauvegardez ce fichier dans un endroit sûr
# 4. Ne commitez JAMAIS ce fichier dans Git
# 5. Redémarrez Maintrix après modification
# 6. Testez la configuration avec: .\test-windows-compatibility.ps1
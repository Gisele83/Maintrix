{
  "name": "maintrix-desktop",
  "productName": "Maintrix",
  "version": "2.6.0",
  "description": "Plateforme industrielle intelligente — Supervision, GMAO, Diagnostic IA",
  "main": "main.js",
  "author": {
    "name": "Maintrix",
    "email": "contact@maintrix.io",
    "url": "https://maintrix.io"
  },
  "license": "Commercial",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "io.maintrix.desktop",
    "productName": "Maintrix",
    "copyright": "Copyright © 2024-2026 Maintrix",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "../dist/**/*",
      "../server/**/*",
      "../shared/**/*",
      "../package.json",
      "!**/node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "msi", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Maintrix-Setup-${version}.${ext}",
      "publisherName": "Maintrix",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Maintrix",
      "include": "assets/installer.nsh",
      "language": "1036"
    },
    "msi": {
      "createDesktopShortcut": true,
      "shortcutName": "Maintrix"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "pkg", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "artifactName": "Maintrix-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        { "target": "deb", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] },
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png",
      "category": "Science;Engineering",
      "artifactName": "Maintrix-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "maintrix",
      "repo": "maintrix-desktop"
    }
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1"
  }
}
